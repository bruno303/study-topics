# Copy to .env and fill in. Load with your shell (e.g. `set -a; . ./.env; set +a`)
# or export the variables by hand before running uvicorn.

# Personal / workspace API key from https://opencode.ai/console.
# With an OpenCode Go subscription this key bills against the Go allowance.
OPENCODE_API_KEY=

# OpenAI Chat Completions family model ID. Read from env.
# Go example ids: glm-5.3, glm-5.3-flash, kimi-k3, kimi-k3.1-pro, kimi-k2.7-code,
# longcat-2.0, ... (live list: curl https://opencode.ai/inference/go/v1/models)
# glm-5.3-flash has the largest Go monthly allowance and the lowest price.
OPENCODE_MODEL=glm-5.3-flash

# OpenCode Go base URL (note: /inference/go/...). LangChain appends
# /chat/completions itself, so this must NOT contain the path suffix
# (a common 404 trap).
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Without a Go subscription (pay-as-you-go Console key), use instead:
# OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1

# Optional overrides. By default the client sends a self-identified User-Agent
# (langchain-study/<version>) and a session id generated once per process;
# both are what OpenCode Go recommends clients send.
# OPENCODE_SESSION_ID=my-stable-analysis-session
# OPENCODE_USER_AGENT=my-car-analyzer/1.0
